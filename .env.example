# Copy to .env in the repository root. Settings loads this independently of the IDE working directory.
# Use "preview" for a credential-free rehearsal; "launchdarkly" enables real SDK decisions.
# The default runs immediately without accounts. Switch to launchdarkly after filling LD_SDK_KEY.
APP_MODE=preview
# Replace the empty value with the SERVER SDK KEY from your selected LD environment.
# Never commit .env or expose this key through React/VITE variables.
LD_SDK_KEY=
# Re-create this Boolean flag in your own LD project: true=new panel, false=existing panel.
# Configure its off variation as false; the SDK fallback is also false.
LD_OFFERS_FLAG_KEY=personalized-offers
# Create a Generic trigger for this flag in Test with action OFF, and paste its URL in .env.
# It is displayed once on creation. Keep it private; the URL itself authorizes the action.
LD_FLAG_TRIGGER_URL=
# PUBLIC browser credential from the SAME Test environment, for Observability and Session Replay.
# Enable Available on client-side SDKs on personalized-offers for browser flag correlation.
LD_CLIENT_SIDE_ID=
# Enable only after creating the Completion config in the same LD Test environment.
AI_ENABLED=false
LD_AI_CONFIG_KEY=offer-assistant
# OpenAI API credential, not a ChatGPT subscription token. Never expose through VITE or commit .env.
OPENAI_API_KEY=
